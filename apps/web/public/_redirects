# SPA rewrites for /trasy/* and /szczyty/* live in the Worker
# (apps/web/worker/index.ts), not here.
#
# Cloudflare Workers Static Assets serves a `_redirects` rule with
# status 200 as a 307 Temporary Redirect (unlike Cloudflare Pages, where
# status 200 is an internal rewrite). That broke the slug — useParams()
# saw `/_shells/szczyty` instead of `/szczyty/rysy/`. The Worker now
# fetches `_shells/<route>.html` via env.ASSETS.fetch and returns it as
# 200, leaving the URL bar untouched.
#
# Postbuild `apps/web/scripts/copy-spa-shells.mjs` still copies the
# placeholder shells to `out/_shells/<route>.html` — the Worker reads
# from there.
