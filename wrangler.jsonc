{
  // Cloudflare Workers + Static Assets config for the frontend.
  // The build step (`pnpm -F sprawdzamszlak-frontend build`) produces a
  // pure-static export under apps/web/out/, which Cloudflare serves directly.
  //
  // Worker name must match the one set in the Cloudflare dashboard. If they
  // diverge, deploy fails with "Worker not found".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprawdzamszlak",
  "compatibility_date": "2026-05-03",

  "assets": {
    "directory": "./apps/web/out",
    // SPA fallback so dynamic routes like /trasy/[slug]/ (Strava-imported
    // activities, slugs known only at runtime) hydrate against the static
    // shell. Pre-rendered routes (/, /strava/, /strava/connected/) still
    // serve directly. Trade-off: typo URLs serve index.html and the SPA
    // shows an empty state instead of a hard 404 — acceptable for a
    // single-user app.
    "not_found_handling": "single-page-application"
  }
}
