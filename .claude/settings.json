{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(pnpm install)",
      "Bash(pnpm *)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm audit*)",
      "Bash(npx *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git stash*)",
      "Bash(git subtree add *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(tree *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)",
      "Bash(terraform init*)",
      "Bash(terraform show*)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git checkout main)",
      "Bash(git checkout master)",
      "Bash(npm publish*)",
      "Bash(npm uninstall*)",
      "Bash(pnpm publish*)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform state mv*)",
      "Bash(terraform state rm*)",
      "Bash(aws *)",
      "WebFetch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.*.local)",
      "Read(**/terraform.tfstate)",
      "Read(**/terraform.tfstate.backup)",
      "Read(**/*.tfvars)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Edit(.env.*.local)",
      "Edit(**/terraform.tfstate)",
      "Edit(**/*.tfvars)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.production)",
      "Write(**/terraform.tfstate)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .git)",
      "Bash(terraform apply -auto-approve*)",
      "Bash(terraform destroy -auto-approve*)",
      "Bash(curl *|*sh)",
      "Bash(wget *|*sh)"
    ]
  },
  "model": "claude-opus-4-7"
}
