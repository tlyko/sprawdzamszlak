{
  "name": "sprawdzamszlak",
  "version": "0.0.0",
  "private": true,
  "description": "Mountain hiking activities visualization (Tatra, off-piste). Monorepo.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "dev:web": "pnpm -F sprawdzamszlak-frontend dev",
    "dev:api": "pnpm -F @sprawdzamszlak/api dev"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "~5.6.0"
  }
}
