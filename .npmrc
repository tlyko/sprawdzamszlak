# Hoist all dependencies to top-level node_modules.
# Some packages (Next.js, leaflet plugins) expect classic flat layout and break under pnpm strict isolation.
# We can revisit later — for W1 we prioritise "things just work".
node-linker=hoisted

# Auto-install peer dependencies that aren't declared.
# Useful with React 19 + Next 16 ecosystem where peer specs are sometimes outdated.
auto-install-peers=true

# Allow scripts that some native deps need (e.g. esbuild postinstall to fetch the binary).
enable-pre-post-scripts=true
