# Local development env vars. Copy to .env (gitignored) and fill in.
# Production values live in AWS Parameter Store / Secrets Manager — never here.

# Strava OAuth (W4) — register the app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Verify token sent during webhook subscription handshake. Random string.
STRAVA_VERIFY_TOKEN=

# Admin panel (W3) — basic auth for now (single user). Switch to NextAuth/Resend later.
ADMIN_USER=
ADMIN_PASS=

# AWS (read from ~/.aws/credentials or SSO when running locally)
AWS_REGION=eu-west-1

# DynamoDB / S3 names — kept here so apps/api can run locally against prod-like names
DYNAMODB_TABLE_NAME=sprawdzamszlak-data
DYNAMODB_ROUTES_TABLE_NAME=sprawdzamszlak-routes
S3_BUCKET_NAME=sprawdzamszlak-trails-storage-214598715232

# Frontend
NEXT_PUBLIC_API_URL=https://akoz890bg6.execute-api.eu-west-1.amazonaws.com/prod

# Stadia Maps (PR 2 "cartographic-pass"). Register at
# https://client.stadiamaps.com/dashboard/ → Manage Properties; add your
# domain (e.g. sprawdzamszlak.pl). Domain-based auth is the default — no
# key needed in code; Stadia validates Referer.
#
# NEXT_PUBLIC_STADIA_KEY is OPTIONAL and only needed if you want belt-and-
# braces authentication (key + domain restriction together) or if the
# rendering machine's Referer isn't covered by any Stadia property.
NEXT_PUBLIC_STADIA_KEY=

# Force OSM tiles instead of Stadia. Set to "true" for local dev when
# your dev origin (e.g. localhost) isn't a registered Stadia property.
NEXT_PUBLIC_USE_OSM=
